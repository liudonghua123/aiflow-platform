{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "AIFlow UI (TinyBuddy UI v0.2.1)",
  "version": "0.2.1",
  "meta": {
    "description": "Design tokens per TinyBuddy UI spec (commit ee2a698). Values are bare R G B triplets for rgb(var(--token) / alpha) usage.",
    "modes": ["light", "dark"],
    "source": "https://github.com/liudonghua123/tiny-buddy/commit/ee2a698157302112a15e0c4e2c76092d21bc4b2e"
  },
  "color": {
    "bg": { "light": "246 246 249", "dark": "12 12 17", "role": "canvas" },
    "surface": { "light": "255 255 255", "dark": "20 20 27", "role": "card" },
    "elevated": { "light": "255 255 255", "dark": "25 25 33", "role": "raised" },
    "line": { "light": "233 233 240", "dark": "38 38 47", "role": "border" },
    "ink": { "light": "23 23 29", "dark": "236 236 242", "role": "text-primary" },
    "muted": { "light": "106 107 118", "dark": "155 156 168", "role": "text-secondary" },
    "faint": { "light": "154 155 166", "dark": "111 112 124", "role": "text-tertiary" },
    "brand": { "light": "109 74 255", "dark": "139 109 255", "role": "accent" },
    "brand-soft": { "light": "240 236 255", "dark": "33 26 61", "role": "accent-surface" },
    "brand-ink": { "light": "75 47 208", "dark": "196 181 255", "role": "accent-text" },
    "ok": { "light": "31 157 114", "dark": "62 207 154", "role": "success" },
    "warn": { "light": "194 117 31", "dark": "226 164 90", "role": "warning" },
    "danger": { "light": "209 73 91", "dark": "242 112 127", "role": "danger" }
  },
  "contrast": {
    "ink/surface": { "light": 17.85, "dark": 15.58 },
    "muted/surface": { "light": 5.28, "dark": 6.73 },
    "faint/surface": { "light": 2.76, "dark": 3.74, "warning": "below WCAG AA, decorative use only" },
    "brand-ink/brand-soft": { "light": 6.94, "dark": 8.91 },
    "white/brand": { "light": 5.15, "dark": 3.67, "warning": "dark mode: AA-large only, >=14px semibold" }
  },
  "typography": {
    "fontFamily": {
      "sans": "-apple-system, BlinkMacSystemFont, Inter, Segoe UI, PingFang SC, Hiragino Sans GB, Microsoft YaHei, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scaleStep": "0.5px",
    "scale": {
      "hero": { "size": 34, "weight": 600, "lineHeight": 1.2, "usage": "login hero" },
      "h1": { "size": 26, "weight": 600, "lineHeight": 1.2, "usage": "page title (sm+)" },
      "h1-mobile": { "size": 22, "weight": 600, "lineHeight": 1.25 },
      "modal-title": { "size": 16, "weight": 600 },
      "body-lg": { "size": 15, "weight": 400, "lineHeight": 1.72, "usage": "markdown body / empty title" },
      "bubble": { "size": 14.5, "weight": 400, "lineHeight": 1.65, "usage": "user message" },
      "button-lg": { "size": 14, "weight": 500 },
      "nav": { "size": 13.5, "weight": 500 },
      "control": { "size": 13, "weight": 500 },
      "control-sm": { "size": 12.5, "weight": 400 },
      "label": { "size": 12, "weight": 500, "letterSpacing": "0.05em", "textTransform": "uppercase" },
      "meta": { "size": 11.5, "weight": 400 },
      "chip": { "size": 11, "weight": 500 },
      "micro": { "size": 10.5, "weight": 500 },
      "decorative": { "size": 9.5, "weight": 400 }
    }
  },
  "space": {
    "base": 4,
    "iconText": [6, 8, 10],
    "controlPadding": { "x": 14, "y": 8 },
    "cardPadding": [16, 20],
    "sectionGap": [20, 28],
    "pagePadding": { "mobile": 16, "desktop": 24 }
  },
  "radius": {
    "sm": 6,
    "md": 8,
    "control": 14,
    "container": 18,
    "modal": 24,
    "pill": 999
  },
  "shadow": {
    "soft": "0 1px 2px rgba(16,16,24,.04), 0 8px 24px -12px rgba(16,16,24,.12)",
    "lift": "0 2px 4px rgba(16,16,24,.04), 0 16px 40px -16px rgba(16,16,24,.2)",
    "usage": "Borders over shadows. Cards = 1px line + shadow-soft; lift only for elevation (modal, toast, dropdown)."
  },
  "motion": {
    "fade-up": { "duration": 280, "easing": "cubic-bezier(.2,.8,.2,1)", "distance": 6 },
    "pulse-soft": { "duration": 1400, "easing": "ease-in-out", "iterations": "infinite" },
    "press": { "scale": 0.98, "duration": 150 },
    "ping-soft": { "duration": 1000, "easing": "cubic-bezier(0,0,.2,1)", "usage": "status-dot ok outer ring" },
    "reducedMotion": "All animations degrade under prefers-reduced-motion: reduce."
  },
  "breakpoints": {
    "sm": 640,
    "lg": 1024,
    "note": "lg is the only form-factor breakpoint (<1024 mobile, >=1024 desktop)."
  },
  "layout": {
    "sidebar": 252,
    "sidebarCollapsed": 60,
    "chatColumn": 760,
    "contentColumns": { "narrow": 760, "medium": 896, "wide": 1024, "analytics": 1100 },
    "mobileHeader": 48,
    "mobileBottomNav": 56,
    "minTouchTarget": 36
  },
  "zIndex": {
    "drawer": 70,
    "modal": 80,
    "toast": 100
  },
  "components": {
    "button": {
      "height": 36,
      "heightLg": 44,
      "heightSm": 28,
      "radius": 14,
      "fontSize": 13.5,
      "variants": ["primary", "secondary", "ghost", "danger"]
    },
    "iconButton": { "size": 36, "radius": 14 },
    "input": {
      "height": 40,
      "radius": 14,
      "focus": "border brand/50 + 4px ring brand/10, never outline"
    },
    "card": { "radius": 18, "border": "1px solid line", "shadow": "soft", "padding": [16, 20] },
    "chip": { "height": 20, "fontSize": 11, "radius": 999, "default": "bg-elevated border-line text-muted" },
    "statusDot": { "size": 8, "states": ["ok", "warn", "danger", "idle"], "okRing": "animate ping-soft" },
    "switch": { "track": "38x22", "thumb": 16, "travel": 16, "on": "bg-brand", "off": "bg-line" },
    "tabs": {
      "form": "segmented slot",
      "container": "rounded-xl border-line bg-elevated p-1",
      "active": "bg-surface text-ink shadow-sm",
      "itemPadding": "6px 14px",
      "fontSize": 13
    },
    "modal": {
      "radius": 24,
      "zIndex": 80,
      "mask": "black/40 + backdrop-blur 2px",
      "desktop": "centered, max-w-lg (wide: max-w-2xl), max-h 90vh",
      "mobile": "bottom sheet rounded-t-24, drawer-up 280ms, safe-bottom"
    },
    "toast": {
      "radius": 18,
      "zIndex": 100,
      "position": { "desktop": "top-right 24px", "mobile": "above bottom nav, centered" },
      "style": "bg-surface/95 border-line shadow-lift backdrop-blur",
      "fontSize": 13.5,
      "duration": { "success": 3200, "error": 5200 }
    },
    "emptyState": {
      "container": "dashed border-line rounded-2xl, py 56",
      "iconBlock": "48px rounded-2xl bg-brand-soft text-brand",
      "title": "15px/600 ink",
      "desc": "13px muted max-w-sm"
    },
    "pageHeader": { "title": "22px (sm 26px) / 600 / tracking-tight", "subtitle": "13.5px muted", "marginBottom": 20 },
    "nav": {
      "sidebarItem": { "fontSize": 13.5, "weight": 500, "height": 34, "active": "bg-brand-soft text-brand-ink + 6px dot right, icon stroke 2.2" },
      "bottomNavItem": { "icon": 20, "text": "10.5px", "active": "24x2px brand bar on top" }
    }
  },
  "icons": {
    "style": "stroke currentColor, fill none",
    "strokeWidth": { "default": 2, "active": 2.2 },
    "sizes": { "nav": 15, "tabbar": 20, "drawer": 18 }
  }
}
